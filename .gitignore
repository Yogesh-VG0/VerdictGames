scripts/analyze-live-responses.mjs
scripts/apply-migration-*.mjs
scripts/apply-schema.mjs
scripts/backfill-*.mjs
!scripts/backfill-games.mjs
!scripts/backfill-mobile-listings.mjs
scripts/check-igdb.mjs
scripts/cleanup-public-safety.mjs
scripts/fix-wrong-igdb-matches.mjs
scripts/ingest-full-library.mjs
scripts/migrate-*.mjs
scripts/refresh-*.mjs
scripts/reingest-critical.mjs
scripts/repair-missing-media.mjs
scripts/update-igdb-images.mjs
scripts/upgrade-rawg-to-igdb.mjs
scripts/verify-*.mjs
scripts/seed-flags.mjs

