# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# backfill pipeline checkpoint (local state, not committed)
.backfill-checkpoint.json
.import-games-checkpoint.json
.import-games-failures.json
.import-games-*-checkpoint.json
.import-games-*-failures.json
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MCP config (contains API keys)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE config
.cursor/
.windsurf/

# Development/one-time scripts (not needed in production)
