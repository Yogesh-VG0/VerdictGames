{
  "password_min_length": 15,
  "mailer_subjects_confirmation": "Confirm your VerdictGames account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your VerdictGames account</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#eef1f7;color:#182031;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Confirm your VerdictGames account. This link is personal and single-use.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #d5dbe6;border-radius:20px\"><tr><td style=\"padding:32px 28px\">\n<p style=\"margin:0 0 28px;font-size:20px;font-weight:bold;color:#334dc7\">VERDICT<span style=\"color:#485369;font-weight:normal\">.games</span></p>\n<h1 style=\"margin:0 0 16px;font-size:26px;line-height:1.25;color:#182031\">Welcome to VerdictGames</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.6\">Confirm your email to start saving games, building collections and sharing your verdicts.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#334dc7\" style=\"border-radius:10px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 24px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none\">Confirm email</a></td></tr></table>\n<p style=\"margin:24px 0 12px;font-size:14px;line-height:1.6;color:#485369\">This link can be used once and expires according to our account security settings. If it has expired, request a new link from VerdictGames.</p>\n<p style=\"margin:0 0 8px;font-size:13px;line-height:1.6;color:#485369\">If the button does not work, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;word-break:break-all;overflow-wrap:anywhere;font-size:12px;line-height:1.6\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#334dc7\">{{ .ConfirmationURL }}</a></p>\n<p style=\"border-top:1px solid #d5dbe6;padding-top:20px;margin:0;font-size:13px;line-height:1.6;color:#485369\">If you did not create this account, you can ignore this email. VerdictGames will never ask you to send your password by email.</p>\n</td></tr></table><p style=\"font-size:12px;color:#485369\">Your next game starts with a verdict.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_recovery": "Reset your VerdictGames password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Reset your VerdictGames password</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#eef1f7;color:#182031;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Reset your VerdictGames password. This link is personal and single-use.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #d5dbe6;border-radius:20px\"><tr><td style=\"padding:32px 28px\">\n<p style=\"margin:0 0 28px;font-size:20px;font-weight:bold;color:#334dc7\">VERDICT<span style=\"color:#485369;font-weight:normal\">.games</span></p>\n<h1 style=\"margin:0 0 16px;font-size:26px;line-height:1.25;color:#182031\">Choose a new password</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.6\">We received a request to reset your password. Continue to choose a new, unique password.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#334dc7\" style=\"border-radius:10px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 24px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none\">Reset password</a></td></tr></table>\n<p style=\"margin:24px 0 12px;font-size:14px;line-height:1.6;color:#485369\">This link can be used once and expires according to our account security settings. If it has expired, request a new link from VerdictGames.</p>\n<p style=\"margin:0 0 8px;font-size:13px;line-height:1.6;color:#485369\">If the button does not work, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;word-break:break-all;overflow-wrap:anywhere;font-size:12px;line-height:1.6\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#334dc7\">{{ .ConfirmationURL }}</a></p>\n<p style=\"border-top:1px solid #d5dbe6;padding-top:20px;margin:0;font-size:13px;line-height:1.6;color:#485369\">If you did not request this, ignore this email. Your password has not changed. VerdictGames will never ask you to send your password by email.</p>\n</td></tr></table><p style=\"font-size:12px;color:#485369\">Your next game starts with a verdict.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_email_change": "Confirm your new VerdictGames email",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your new VerdictGames email</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#eef1f7;color:#182031;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Confirm your new VerdictGames email. This link is personal and single-use.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #d5dbe6;border-radius:20px\"><tr><td style=\"padding:32px 28px\">\n<p style=\"margin:0 0 28px;font-size:20px;font-weight:bold;color:#334dc7\">VERDICT<span style=\"color:#485369;font-weight:normal\">.games</span></p>\n<h1 style=\"margin:0 0 16px;font-size:26px;line-height:1.25;color:#182031\">Confirm your email change</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.6\">Confirm this email address for your VerdictGames account. You may also need to confirm the change from your original inbox.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#334dc7\" style=\"border-radius:10px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 24px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none\">Confirm email change</a></td></tr></table>\n<p style=\"margin:24px 0 12px;font-size:14px;line-height:1.6;color:#485369\">This link can be used once and expires according to our account security settings. If it has expired, request a new link from VerdictGames.</p>\n<p style=\"margin:0 0 8px;font-size:13px;line-height:1.6;color:#485369\">If the button does not work, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;word-break:break-all;overflow-wrap:anywhere;font-size:12px;line-height:1.6\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#334dc7\">{{ .ConfirmationURL }}</a></p>\n<p style=\"border-top:1px solid #d5dbe6;padding-top:20px;margin:0;font-size:13px;line-height:1.6;color:#485369\">If you did not request this, secure your account and contact support through VerdictGames. VerdictGames will never ask you to send your password by email.</p>\n</td></tr></table><p style=\"font-size:12px;color:#485369\">Your next game starts with a verdict.</p>\n</td></tr></table></body></html>\n",
  "mailer_subjects_magic_link": "Your VerdictGames sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Your VerdictGames sign-in link</title></head>\n<body style=\"margin:0;padding:24px 12px;background:#eef1f7;color:#182031;font-family:Arial,Helvetica,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Your VerdictGames sign-in link. This link is personal and single-use.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #d5dbe6;border-radius:20px\"><tr><td style=\"padding:32px 28px\">\n<p style=\"margin:0 0 28px;font-size:20px;font-weight:bold;color:#334dc7\">VERDICT<span style=\"color:#485369;font-weight:normal\">.games</span></p>\n<h1 style=\"margin:0 0 16px;font-size:26px;line-height:1.25;color:#182031\">Sign in to VerdictGames</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.6\">Use this single-use link to continue signing in to your account.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#334dc7\" style=\"border-radius:10px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 24px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none\">Sign in</a></td></tr></table>\n<p style=\"margin:24px 0 12px;font-size:14px;line-height:1.6;color:#485369\">This link can be used once and expires according to our account security settings. If it has expired, request a new link from VerdictGames.</p>\n<p style=\"margin:0 0 8px;font-size:13px;line-height:1.6;color:#485369\">If the button does not work, copy this link into your browser:</p>\n<p style=\"margin:0 0 24px;word-break:break-all;overflow-wrap:anywhere;font-size:12px;line-height:1.6\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#334dc7\">{{ .ConfirmationURL }}</a></p>\n<p style=\"border-top:1px solid #d5dbe6;padding-top:20px;margin:0;font-size:13px;line-height:1.6;color:#485369\">If you did not request this, ignore this email. Do not share this link. VerdictGames will never ask you to send your password by email.</p>\n</td></tr></table><p style=\"font-size:12px;color:#485369\">Your next game starts with a verdict.</p>\n</td></tr></table></body></html>\n"
