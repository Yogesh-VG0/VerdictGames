  "mailer_templates_confirmation_content": "<!doctype html>\r\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Confirm your VerdictGames account</title></head>\r\n<body style=\"margin:0;padding:24px 12px;background:#eef1f7;color:#182031;font-family:Arial,Helvetica,sans-serif\">\r\n<div style=\"display:none;max-height:0;overflow:hidden\">Your one-time VerdictGames confirmation code.</div>\r\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\">\r\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #d5dbe6;border-radius:20px\"><tr><td style=\"padding:32px 28px\">\r\n<p style=\"margin:0 0 28px;font-size:20px;font-weight:bold;color:#334dc7\">VERDICT<span style=\"color:#485369;font-weight:normal\">.games</span></p>\r\n<h1 style=\"margin:0 0 16px;font-size:26px;line-height:1.25;color:#182031\">Welcome to VerdictGames</h1>\r\n<p style=\"margin:0 0 24px;font-size:16px;line-height:1.6\">Enter this code in your signup tab to confirm your email and sign in. You can read this email on any device.</p>\r\n<p style=\"margin:0 0 20px;font-size:28px;font-weight:bold;letter-spacing:6px;color:#182031\">{{ .Token }}</p>\r\n<p style=\"margin:24px 0 12px;font-size:14px;line-height:1.6;color:#485369\">Use the latest code once, in the browser where you want to sign in. If it has expired, request a new code. Never share your code.</p>\r\n<p style=\"margin:0 0 8px;font-size:13px;line-height:1.6;color:#485369\">Closed your signup tab? Open the confirmation form and enter your email and code there. This page does not verify your account until you enter the code:</p>\r\n<p style=\"margin:0 0 24px;word-break:break-all;overflow-wrap:anywhere;font-size:12px;line-height:1.6\"><a href=\"{{ .SiteURL }}/auth/confirm\" style=\"color:#334dc7\">{{ .SiteURL }}/auth/confirm</a></p>\r\n<p style=\"border-top:1px solid #d5dbe6;padding-top:20px;margin:0;font-size:13px;line-height:1.6;color:#485369\">If you did not create this account, you can ignore this email. VerdictGames will never ask you to send your password by email.</p>\r\n</td></tr></table><p style=\"font-size:12px;color:#485369\">Your next game starts with a verdict.</p>\r\n</td></tr></table></body></html>\r\n"
}
